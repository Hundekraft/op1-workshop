 /* recording as text: 'r', then 6 characters per chord: bass, the three upper intervals (0 = none) and the root
diff --git a/ext/kennel/synth_sdk/harness/settings_db_full_test.c b/ext/kennel/synth_sdk/harness/settings_db_full_test.c
new file mode 100644
index 0000000..9f59fdc
--- /dev/null
+++ b/ext/kennel/synth_sdk/harness/settings_db_full_test.c
@@ -0,0 +1,166 @@
+/* Host test: settings on a full flash (kennel/kn_settings.c, screens/settings_store.c) must not reach db2::exec.
+ *
+ *   cd ext/kennel/synth_sdk && cc -g -O1 -fsanitize=address,undefined -fno-sanitize-recover=undefined -I. \
+ *       harness/settings_db_full_test.c kennel/kn_settings.c screens/settings_store.c -o /tmp/settings_db_full_test \
+ *       && /tmp/settings_db_full_test
+ *
+ * Built WITHOUT -DOP1_HOST on purpose: kn_settings.c has no host branch, and settings_store.c's host branch is a RAM
+ * table, so the firmware DB code is what runs here. Its R246 calls go to fixed addresses; this maps that range and
+ * puts a jump at each one to a model below (an empty op1.db: tables, rows, a "flash full" switch):
+ *   0x0196DD44 db handle, 0x0196F950 db2::exec (asserts on any error: here a longjmp that fails the check),
+ *   0x0196FBD0 db2::get (asserts when the statement does not prepare, e.g. a missing table), 0x019C9460 sqlite3_exec
+ *   (what op1_db_write calls), 0x01A5E310 operator delete, 0x01BAB718 db2's lock (0: none).
+ * Prints "N/M ok"; exit 0 only when every check passes. 64-bit Linux, aarch64 or x86_64. */
+#include <setjmp.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+
+/* what the two files expect from the rest of the core */
+int32_t op1_db_last_err;
+uint8_t ci_beats = 4, ci_click, ci_click_fx;
+int kn_setcache_get(const char *feature, const char *key, int32_t *out) { (void)feature; (void)key; (void)out; return 0; }
+void kn_setcache_put(const char *feature, const char *key, int32_t v) { (void)feature; (void)key; (void)v; }
+int32_t op1_setting_get(const char *, const char *, int32_t);
+void op1_setting_set(const char *, const char *, int32_t);
+int op1_setting_get_str(const char *, const char *, char *, int);
+void op1_setting_set_str(const char *, const char *, const char *);
+void kn_off_store(const char *);
+const char *kn_off_boot(void);
+int usbout_load(void);
+void usbout_save(int);
+void countin_load(void);
+void countin_save(int);
+void click_save(int);
+void settings_flush(void);
+
+/* ---- op1.db model: table op1rsettings (key, val as text) ---- */
+static int full, have_table, asserts, writes;
+static struct { char key[40], val[200]; } rows[32];
+static int nrows;
+static const char *row(const char *key) { for (int i = 0; i < nrows; i++) if (!strcmp(rows[i].key, key)) return rows[i].val; return 0; }
+static int model_exec(const char *sql)              /* sqlite3_exec: 0, or 13 SQLITE_FULL / 1 no such table */
+{
+    if (!strncmp(sql, "CREATE TABLE IF NOT EXISTS op1rsettings ", 40)) {
+        if (have_table) return 0;                   /* IF NOT EXISTS: nothing written */
+        if (full) return 13;                        /* a new table needs free pages */
+        have_table = 1; return 0;
+    }
+    const char *h = "INSERT OR REPLACE INTO op1rsettings VALUES ('";
+    if (!strncmp(sql, h, strlen(h))) {
+        if (!have_table) return 1;
+        if (full) return 13;
+        const char *k = sql + strlen(h), *ke = strchr(k, '\''), *v = ke + 2, *ve = strrchr(sql, ')');
+        if (*v == '\'') { v++; ve--; }
+        char key[40]; snprintf(key, sizeof key, "%.*s", (int)(ke - k), k);
+        int i = 0; while (i < nrows && strcmp(rows[i].key, key)) i++;
+        if (i == nrows) nrows++;
+        strcpy(rows[i].key, key); snprintf(rows[i].val, sizeof rows[i].val, "%.*s", (int)(ve - v), v);
+        while (rows[i].val[0] == ' ') memmove(rows[i].val, rows[i].val + 1, strlen(rows[i].val));
+        writes++;
+        return 0;
+    }
+    fprintf(stderr, "model: unknown SQL %s\n", sql);
+    abort();
+}
+static jmp_buf on_assert;
+static void db2_assert(const char *what, const char *sql) { printf("    (db2 assert in %s: %s)\n", what, sql); asserts++; longjmp(on_assert, 1); }
+
+static struct { void *conn; } handle = { (void *)&handle };
+static void *f_handle(void) { return &handle; }
+static void f_exec(void *db, const char *sql) { (void)db; if (model_exec(sql)) db2_assert("db2::exec", sql); }
+static int f_sqlite_exec(void *conn, const char *sql, void *cb, void *arg, char **err)
+{
+    (void)conn; (void)cb; (void)arg; (void)err;
+    return model_exec(sql);
+}
+typedef struct { uint32_t alloc; union { char buf[16]; char *ptr; } u; uint32_t size, cap; uint32_t pad; } dstr;
+static void f_get(void *out, void *db, const char *sql)
+{
+    (void)db;
+    const char *h = "SELECT val FROM op1rsettings WHERE key='";
+    if (strncmp(sql, h, strlen(h))) { fprintf(stderr, "model: unknown SELECT %s\n", sql); abort(); }
+    if (!have_table) db2_assert("db2::get", sql);  /* no such table: the statement does not prepare */
+    char key[40]; snprintf(key, sizeof key, "%.*s", (int)strlen(sql + strlen(h)) - 1, sql + strlen(h));
+    const char *v = row(key);
+    dstr *s = out;
+    memset(s, 0, sizeof *s);
+    if (!v) return;
+    s->size = (uint32_t)strlen(v);
+    if (s->size > 15) { s->cap = s->size; s->u.ptr = strdup(v); } else { s->cap = 15; strcpy(s->u.buf, v); }
+}
+static void f_delete(void *p) { free(p); }
+
+static void jump(uintptr_t at, void *to)            /* a jump at a fixed address to one of the models */
+{
+    uint8_t *p = (uint8_t *)at;
+#if defined(__aarch64__)
+    static const uint32_t code[2] = { 0x58000050, 0xd61f0200 };          /* ldr x16, #8; br x16 */
+    memcpy(p, code, 8); memcpy(p + 8, &to, 8);
+#elif defined(__x86_64__)
+    p[0] = 0x48; p[1] = 0xB8; memcpy(p + 2, &to, 8); p[10] = 0xFF; p[11] = 0xE0;   /* movabs rax; jmp rax */
+#else
+#error "aarch64 or x86_64"
+#endif
+    __builtin___clear_cache((char *)p, (char *)p + 16);
+}
+static void map_r246(void)
+{
+    void *m = mmap((void *)0x01900000, 0x300000, PROT_READ | PROT_WRITE | PROT_EXEC,
+                   MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+    if (m != (void *)0x01900000) { perror("mmap 0x01900000"); exit(2); }
+    jump(0x0196DD44, (void *)f_handle);
+    jump(0x0196F950, (void *)f_exec);
+    jump(0x0196FBD0, (void *)f_get);
+    jump(0x019C9460, (void *)f_sqlite_exec);
+    jump(0x01A5E310, (void *)f_delete);
+}
+
+static int n_ok, n_all;
+#define CHECK(name, body, cond) do { \
+        n_all++; int a0 = asserts; volatile int ok = 0; \
+        if (!setjmp(on_assert)) { body; ok = (cond); } \
+        ok = ok && asserts == a0; n_ok += ok; \
+        printf("%s %s\n", ok ? "ok  " : "FAIL", name); \
+    } while (0)
+
+int main(void)
+{
+    map_r246();
+    char t[64];
+    printf("full flash, no op1rsettings table (first boot on a full OP-1):\n");
+    full = 1;
+    CHECK("boot: kn_off_boot reads no switched-off list", , kn_off_boot()[0] == 0);
+    CHECK("boot: countin_load keeps the defaults", countin_load(), ci_beats == 4 && ci_click == 0 && ci_click_fx == 0);
+    CHECK("boot: usbout_load is master (0)", , usbout_load() == 0);
+    CHECK("op1_setting_get gives the default", , op1_setting_get("chord", "voice", 7) == 7);
+    CHECK("op1_setting_get_str gives nothing", , op1_setting_get_str("chord", "name", t, sizeof t) == 0 && t[0] == 0);
+    CHECK("op1_setting_set: not saved, no assert", op1_setting_set("chord", "voice", 5), !have_table && writes == 0);
+    CHECK("op1_setting_set_str: not saved, no assert", op1_setting_set_str("chord", "name", "abc"), writes == 0);
+    CHECK("kn_off_store: not saved, no assert", kn_off_store("a,b"), writes == 0);
+    CHECK("usbout_save: not saved, no assert", usbout_save(2), writes == 0);
+    CHECK("settings_flush: not saved, no assert", (countin_save(1), click_save(2), settings_flush()), writes == 0);
+
+    printf("space freed (same boot):\n");
+    full = 0;
+    CHECK("op1_setting_set creates the table and saves", op1_setting_set("chord", "voice", 5),
+          have_table && op1_setting_get("chord", "voice", 7) == 5);
+    CHECK("op1_setting_set_str saves", op1_setting_set_str("chord", "name", "abc"),
+          op1_setting_get_str("chord", "name", t, sizeof t) == 3 && !strcmp(t, "abc"));
+    CHECK("usbout save / load", usbout_save(1), usbout_load() == 1);
+    CHECK("countin save / flush / load", (countin_save(2), settings_flush(), countin_load()), ci_beats == 16);
+
+    printf("flash full again, table there:\n");
+    full = 1;
+    CHECK("op1_setting_get reads the row", , op1_setting_get("chord", "voice", 7) == 5);
+    CHECK("op1_setting_set: INSERT fails, no assert", op1_setting_set("chord", "voice", 9),
+          op1_setting_get("chord", "voice", 7) == 5 && op1_db_last_err == 13);
+    CHECK("usbout_save: INSERT fails, no assert", usbout_save(2), usbout_load() == 1);
+    int w = writes;
+    CHECK("settings_flush: INSERT fails, no assert", (countin_save(0), settings_flush()), writes == w && !strcmp(row("countin"), "2"));
+
+    printf("%d/%d ok, %d db2 asserts\n", n_ok, n_all, asserts);
+    return n_ok == n_all ? 0 : 1;
+}
diff --git a/ext/kennel/synth_sdk/kennel/kn_boot.c b/ext/kennel/synth_sdk/kennel/kn_boot.c
index ff84f36..caa56e3 100644
--- a/ext/kennel/synth_sdk/kennel/kn_boot.c
+++ b/ext/kennel/synth_sdk/kennel/kn_boot.c
@@ -68,7 +68,6 @@ typedef struct { uint32_t alloc; union { char buf[16]; char *ptr; } u; uint32_t
 #define OP_DELETE  ((void (*)(void *))0x01A5E310)
 #define DB_HANDLE  ((void *(*)(void))0x0196DD44)                  /* user/op1.db: the number map */
 #define DB_FACTORY ((void *(*)(void))0x0196DD38)                  /* content/op1_factory.db: synth_types / fx_types */
-#define DB_EXEC    ((void (*)(void *, const char *))0x0196F950)
 #define DB_GET     ((void (*)(void *, void *, const char *))0x0196FBD0)
 
 #define DIR_PLUGINS   "/yaffs2/plugins"
@@ -210,10 +209,16 @@ void kn_log_line(const char *file, const char *msg)
 /* ---- name -> number map, one text row in op1.db, op1r's format: "s:name=n,f:name=n," (- prefix: plugin gone) ---- */
 #define MAP_MAX 128                                             /* both kinds: up to 63 numbers each */
 static struct { char kind, present; char name[16]; int n; } map[MAP_MAX] kn_farbss;
-static int map_n, map_dirty;
+static int map_n, map_dirty, map_nostore;
 static void map_load(void *db)
 {
-    DB_EXEC(db, "CREATE TABLE IF NOT EXISTS op1rplugins (id INTEGER PRIMARY KEY, data TEXT NOT NULL)");
+    /* Not db2::exec (0x0196F950): it asserts on any sqlite error, and a CREATE needs free pages, so a full flash on
+     * an OP-1 without the table asserted here, every boot. No table: an empty map (numbers for this boot only), not
+     * read (db2_get asserts on a missing table too) and not saved (op1r-src 72). */
+    if (op1_db_write(db, "CREATE TABLE IF NOT EXISTS op1rplugins (id INTEGER PRIMARY KEY, data TEXT NOT NULL)")) {
+        map_nostore = 1;
+        return;
+    }
     kn_dstr s; dstr_init(&s);
     DB_GET(&s, db, "SELECT data FROM op1rplugins WHERE id=0");
     const char *p = s.cap > 15 ? s.u.ptr : s.u.buf, *e = p + s.size;
@@ -238,6 +243,7 @@ static void map_load(void *db)
 static void map_save_row(void *db, int id)                       /* id 0: the map; 1: the copy kept before a compaction */
 {
     static char sql[64 + MAP_MAX * 24];
+    if (map_nostore) return;                                    /* a map we could not read: don't overwrite its rows */
     char *o = scat(sql, id ? "INSERT OR REPLACE INTO op1rplugins VALUES (1,'" : "INSERT OR REPLACE INTO op1rplugins VALUES (0,'");
     for (int i = 0; i < map_n; i++) {
         if (!map[i].present) *o++ = '-';
@@ -666,7 +672,7 @@ static const char *load_knl(int in_plugins, const char *file, const uint8_t *buf
             char path[48];
             if (svg_path(path, in_plugins, file)) kn_ds_asset(f->drum_synth, path);
         }
-        if (!r && f->seq) kn_seq_row_ensure(DB_FACTORY(), in.type_name, DB_EXEC, op1_db_has);
+        if (!r && f->seq) kn_seq_row_ensure(DB_FACTORY(), in.type_name, op1_db_write, op1_db_has);
         if (!r && in.settings) kn_settings_add(f->name, in.settings, in.settings_len);   /* copied: a bad table drops only them */
         if (r) {                                                  /* not registered: its memory back, and the */
             release(save);                                        /* inventory forgets the pointer into it */
@@ -1424,10 +1430,10 @@ void kn_boot_hook(void *clips)
     extern const char *kn_seq_foreign_name(int i);              /* foreign types (kn_seq.c): rows as a .knl type's */
     for (int i = 0; kn_seq_foreign_name(i) && seq_count < 48; i++) {
         seq_names[seq_count++] = kn_seq_foreign_name(i);
-        if (!kn_skipped) kn_seq_row_ensure(DB_FACTORY(), kn_seq_foreign_name(i), DB_EXEC, op1_db_has);
+        if (!kn_skipped) kn_seq_row_ensure(DB_FACTORY(), kn_seq_foreign_name(i), op1_db_write, op1_db_has);
     }
     if (!kn_skipped) {                       /* (a boot that skipped every file: their rows stay for the next one) */
-        kn_seq_rows_cleanup(DB_FACTORY(), seq_names, seq_count, DB_EXEC, op1_db_has);
+        kn_seq_rows_cleanup(DB_FACTORY(), seq_names, seq_count, op1_db_write, op1_db_has);
         kn_rows_finish(seq_names, seq_count);
     }
     extern void kn_artcache_init(int users);
diff --git a/ext/kennel/synth_sdk/kennel/kn_exports.c b/ext/kennel/synth_sdk/kennel/kn_exports.c
index 6d45d4f..3c00939 100644
--- a/ext/kennel/synth_sdk/kennel/kn_exports.c
