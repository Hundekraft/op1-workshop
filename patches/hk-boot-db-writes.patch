diff --git a/ext/kennel/synth_sdk/chord/chord.c b/ext/kennel/synth_sdk/chord/chord.c
index c6fd58f..f411ac2 100644
--- a/ext/kennel/synth_sdk/chord/chord.c
+++ b/ext/kennel/synth_sdk/chord/chord.c
@@ -789,14 +789,22 @@ static void rec_get(char *buf, int size) { int i = 0; for (; chord_host_rec[i] &
 static void rec_put(const char *str) { int i = 0; for (; str[i] && i < 127; i++) chord_host_rec[i] = str[i]; chord_host_rec[i] = 0; }
 #else
 #define DB_HANDLE ((void *(*)(void))0x0196DD44)
-#define DB_EXEC   ((void (*)(void *, const char *))0x0196F950)
 #define DB_GET    ((void (*)(void *, void *, const char *))0x0196FBD0)
 typedef struct { uint32_t alloc; union { char buf[16]; char *ptr; } u; uint32_t size, cap; uint32_t pad; } ch_dstr;
 static const char CH_CREATE[] = "CREATE TABLE IF NOT EXISTS op1rsettings (key TEXT PRIMARY KEY, val INTEGER NOT NULL)";
+/* The table without db2::exec (0x0196F950), which asserts on any sqlite error: a CREATE needs free pages, so a full
+ * flash on an OP-1 without the table asserted on load. Without it: no chord / recording read or saved, no assert
