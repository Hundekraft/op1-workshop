diff --git a/ext/kennel/synth_sdk/kennel/kn_seq_rows.h b/ext/kennel/synth_sdk/kennel/kn_seq_rows.h
index 694b508..ab27a8c 100644
--- a/ext/kennel/synth_sdk/kennel/kn_seq_rows.h
+++ b/ext/kennel/synth_sdk/kennel/kn_seq_rows.h
@@ -8,18 +8,21 @@
 static char *kn_sr_cat(char *d,const char *s){while(*s)*d++=*s++;*d=0;return d;}
 static int kn_sr_name(const char *s){unsigned n=0;if(!s)return 0;for(;s[n];n++)if(n>=15||!((s[n]>='a'&&s[n]<='z')||(s[n]>='0'&&s[n]<='9')||s[n]=='_'||s[n]=='-'))return 0;return n>0;}
 /* has(db, select): 1 when the SELECT returns a row (op1_db_has). Both run their writes only when something would
- * change, so a boot with the same sequencers writes nothing (op1r 46 3f733a8's pattern). */
-static __attribute__((noinline)) void kn_seq_row_ensure(void *db,const char *name,void (*exec)(void *,const char *),int (*has)(void *,const char *)){
+ * change, so a boot with the same sequencers writes nothing (op1r 46 3f733a8's pattern).
+ * exec(db, sql): op1_db_write, 0 or the sqlite error. Not db2::exec (0x0196F950): that asserts on any error, so a
+ * full flash asserted at boot on the first CREATE / INSERT / DELETE here. A step that fails ends the call, so a
+ * seq_types row is only added once it is marked ours (else it would stay for good as a foreign row). */
+static __attribute__((noinline)) void kn_seq_row_ensure(void *db,const char *name,int (*exec)(void *,const char *),int (*has)(void *,const char *)){
  if(!kn_sr_name(name))return;
